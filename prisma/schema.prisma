generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CompetitionLevel {
  POSN
  POSN1
  POSN2
  TMO
  IPST1
  IPST2
  IMO
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  rating        Int       @default(1200)
  globalRank    Int?
  streak        Int       @default(0)
  country       String    @default("TH")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  
  accounts      Account[]
  sessions      Session[]
  submissions   Submission[]
  achievements  UserAchievement[]
  problemSetAttempts ProblemSetAttempt[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Problem {
  id            String    @id @default(cuid())
  code          String    @unique
  title         String
  content       String    @db.Text
  level         CompetitionLevel
  difficulty    Int
  tags          String[]
  
  createdAt     DateTime  @default(now())
  
  submissions   Submission[]
  problemSets   ProblemSetItem[]
}

model Submission {
  id               String    @id @default(cuid())
  userId           String
  problemId        String
  content          String    @db.Text
  status           String    @default("PENDING")
  submittedAt      DateTime  @default(now())
  attemptId        String?

  user             User               @relation(fields: [userId], references: [id])
  problem          Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attempt          ProblemSetAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model CurriculumModule {
  id            String    @id @default(cuid())
  title         String
  description   String?
  level         CompetitionLevel
  order         Int

  lessons       Lesson[]
}

model Lesson {
  id            String    @id @default(cuid())
  moduleId      String
  title         String
  content       String    @db.Text
  order         Int
  videoUrl      String?
  
  module        CurriculumModule @relation(fields: [moduleId], references: [id])
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  icon          String?
  unlockedAt    DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
}

// =======================
// PROBLEM SETS (Mock Exams)
// =======================

model ProblemSet {
  id               String            @id @default(cuid())
  title            String
  description      String?           @db.Text
  timeLimitMinutes Int               @default(90)
  isPublic         Boolean           @default(false)
  createdAt        DateTime          @default(now())

  items            ProblemSetItem[]
  attempts         ProblemSetAttempt[]
}

model ProblemSetItem {
  id             String           @id @default(cuid())
  problemSetId   String
  problemId      String
  order          Int
  
  problemSet     ProblemSet       @relation(fields: [problemSetId], references: [id], onDelete: Cascade)
  problem        Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ProblemSetAttempt {
  id             String     @id @default(cuid())
  userId         String
  problemSetId   String
  startedAt      DateTime   @default(now())
  completedAt    DateTime?
  score          Int?       // Total points/rating delta gained
  status         String     @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, GRADED

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemSet     ProblemSet @relation(fields: [problemSetId], references: [id], onDelete: Cascade)
  submissions    Submission[]
}
